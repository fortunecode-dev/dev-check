{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dev-checks.config.json",
  "type": "object",
  "required": ["projects"],
  "properties": {
    "$schema": { "type": "string" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "description": "Proyectos a revisar. Un cambio en sus archivos los selecciona en modo diff.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Carpeta del proyecto relativa a la raíz del repo (\".\" para la raíz)."
          },
          "stack": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Informativo: lo que detectó init (ts, nest, next, expo, prisma…)."
          },
          "lint": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Argumentos de eslint (rutas o globs). null = sin eslint en este proyecto."
          },
          "typeAware": {
            "type": "boolean",
            "description": "eslint con reglas type-aware: en modo diff revisa solo los archivos cambiados y evita la caché."
          },
          "lintExt": {
            "type": "string",
            "description": "Expresión regular de las extensiones que revisa eslint en modo diff."
          },
          "lintIgnore": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Fragmentos de ruta que eslint ignora en modo diff (por defecto /generated/)."
          },
          "tests": { "enum": ["jest", "vitest", null] },
          "prisma": { "type": "boolean" },
          "expo": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "object",
      "description": "Activa o desactiva cada paso.",
      "properties": {
        "tsc": { "type": "boolean" },
        "eslint": { "type": "boolean" },
        "prettier": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "knip": { "type": "boolean" },
        "depcruise": { "type": "boolean" },
        "prisma": { "type": "boolean" },
        "expo": { "type": "boolean" },
        "syncpack": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "globalFiles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Archivos de la raíz cuyo cambio revisa todos los proyectos."
    },
    "baseline": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "description": "Errores de tsc tolerados por proyecto (uso temporal)."
    },
    "knownEmptySuites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Suites de tests vacías que no cuentan como fallo (por sufijo de nombre)."
    },
    "expoAccepted": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Hallazgos de expo-doctor aceptados por proyecto (expresiones regulares)."
    },
    "hooks": {
      "type": "object",
      "properties": { "enrichCommitMsg": { "type": "boolean" } },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "linkClaudeMd": { "type": "boolean" },
        "noCommit": {
          "type": "boolean",
          "description": "Indica al agente que no haga commit ni push."
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "maxLines": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
